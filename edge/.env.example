# Smart Door Camera Edge Configuration (.env)
DEVICE_ID=pi-front-door-01
DEVICE_API_KEY=sk_device_secret_door_key_12345
BACKEND_URL=http://localhost:8080/api/events

# Local Face Recognition Settings (YuNet + SFace)
FACE_DET_SCORE_THRESH=0.85
FACE_NMS_THRESH=0.3
FACE_RECOG_COSINE_THRESH=0.363
FACE_RECOG_L2_THRESH=1.128
LIVENESS_CONSECUTIVE_FRAMES=3
LIVENESS_MOTION_THRESH=0.015

# Event Management
EVENT_COOLDOWN_SECONDS=30.0

# LLM (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GPIO (Optional Doorbell Button on Raspberry Pi)
ENABLE_GPIO=false
DOORBELL_GPIO_PIN=17

# Offline Outbox
DATABASE_PATH=edge_data.db

# Optional Phone Push Fallback (Telegram Bot API)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
